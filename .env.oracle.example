# Oracle runtime only. Nunca commite o arquivo .env.oracle real.

# Domínios apontando para o IP público da VM Oracle
WAHA_DOMAIN=waha.seudominio.com
REDIS_DOMAIN=redis.seudominio.com
ACME_EMAIL=voce@seudominio.com

# Front/API que continua na Vercel
NEXT_PUBLIC_APP_URL=https://seu-projeto.vercel.app
WAHA_WEBHOOK_BASE_URL=https://seu-projeto.vercel.app

# WAHA
# Gere uma chave longa e guarde o plaintext também na Vercel como WAHA_API_KEY.
WAHA_API_KEY=
# echo -n "$WAHA_API_KEY" | sha512sum | awk '{print $1}'
WAHA_API_KEY_SHA512=
WAHA_HMAC_SECRET=
WHATSAPP_RESTART_ALL_SESSIONS=True
# Ampere A1 ARM64:
WAHA_IMAGE=devlikeapro/waha:noweb-arm-2026.7.2
# Em VM AMD64, troque por:
# WAHA_IMAGE=devlikeapro/waha:noweb-2026.7.2

# Scheduler
INTERNAL_SECRET=

# Redis HTTP
SRH_TOKEN=
UPSTASH_REDIS_REST_URL=https://redis.seudominio.com
UPSTASH_REDIS_REST_TOKEN=

# Supabase usado pelo worker
SUPABASE_DB_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pelo menos um provedor de IA usado pela instalação
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Imagens deste fork
WORKER_IMAGE=ghcr.io/andreajoa/deskcomm-worker:latest
SCHEDULER_IMAGE=ghcr.io/andreajoa/deskcomm-scheduler:latest

NODE_ENV=production
SENTRY_DSN=off
